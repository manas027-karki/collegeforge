# In development, leave this unset.
#
# The Vite dev server proxies `/api` to the backend, so the browser stays on a
# single origin: no CORS negotiation, and the session cookie behaves like a
# same-site request. This also makes `localhost` and `127.0.0.1` equivalent.
#
# For a production build, set it to the public URL of the deployed API:
# VITE_API_URL=https://api.careerforge.app

# Where the Vite dev server proxies `/api`. Change this only if the backend
# is not on its default port.
# VITE_PROXY_TARGET=http://localhost:5000
