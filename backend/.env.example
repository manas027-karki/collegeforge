PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/careerforge"

# Comma-separated allow-list of browser origins allowed to call the API.
#
# `http://localhost:5173` and `http://127.0.0.1:5173` are different origins to
# a browser, and both have to be listed or the browser silently blocks the
# response. A blocked response looks exactly like the API being down.
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173"

# Name of the HTTP-only session cookie. The raw value never reaches JavaScript.
COOKIE_NAME="careerforge_session"

# lax works for same-site deployments and local dev. Set to "none" only for a
# genuinely cross-site frontend, which also requires NODE_ENV=production (HTTPS).
COOKIE_SAME_SITE="lax"

# Lifetime of a login session, in days.
SESSION_DURATION_DAYS=7

# Lifetime of a session created with the "remember me" option, in days.
SESSION_DURATION_DAYS_REMEMBERED=30

# bcrypt cost factor. Higher is slower and stronger; 12 is a good default.
BCRYPT_ROUNDS=12
