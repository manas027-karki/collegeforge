// Prisma 7 emits a typed TypeScript client into src/generated/prisma (see generator block).
// PostgreSQL is the only supported provider for this project.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum JobType {
  INTERNSHIP
  FULL_TIME
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  SELECTED
  REJECTED
}

enum DSADifficulty {
  EASY
  MEDIUM
  HARD
}

enum DSAPlatform {
  LEETCODE
  OTHER
}

enum DSASolveStatus {
  SOLVED
  UNSOLVED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  COMPLETED
}

enum ResumeStatus {
  CURRENT
  ARCHIVED
}

enum ResumeFileType {
  PDF
  DOCX
}

enum NotificationType {
  APPLICATION
  INTERVIEW
  STUDY
  DSA
  JOB
  SYSTEM
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Identity plus profile. `passwordHash` holds a one-way bcrypt digest and must
/// never be selected into an API response.
model User {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  email          String   @unique @db.VarChar(320)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  phone          String?  @db.VarChar(32)
  college        String?  @db.VarChar(160)
  degree         String?  @db.VarChar(120)
  graduationYear Int?     @map("graduation_year")
  bio            String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  applications  Application[]
  dsaProgress   DSAProgress[]
  projects      Project[]
  studyTasks    StudyTask[]
  resumes       Resume[]
  notifications Notification[]

  @@map("users")
}

/// Server-side record backing the HTTP-only session cookie. Only a hash of the
/// opaque cookie value is stored, so a database leak cannot be replayed as a
/// live session. Populated in the authentication phase.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userAgent String?  @map("user_agent") @db.VarChar(256)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Shared reference data. Jobs point at a company rather than duplicating its
/// name, so a company can be renamed once.
model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(160)
  logoUrl     String?  @map("logo_url") @db.VarChar(2048)
  websiteUrl  String?  @map("website_url") @db.VarChar(2048)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@index([name])
  @@map("companies")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  title          String    @db.VarChar(160)
  location       String    @db.VarChar(160)
  type           JobType
  skills         String[]  @default([])
  description    String    @db.Text
  applicationUrl String?   @map("application_url") @db.VarChar(2048)
  deadline       DateTime?
  postedAt       DateTime  @default(now()) @map("posted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Restrict: companies are shared reference data, so a company must not be
  // deleted out from under live job postings.
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([companyId])
  @@index([type])
  @@index([location])
  @@index([deadline])
  @@index([postedAt])
  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  jobId     String            @map("job_id") @db.Uuid
  status    ApplicationStatus @default(SAVED)
  appliedAt DateTime?         @map("applied_at")
  deadline  DateTime?
  notes     String?           @db.Text
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Applications are personal history. They survive a user deletion only via the
  // cascade, and survive job deletion.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)

  // One application per user per job.
  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([deadline])
  @@map("applications")
}

model DSAProblem {
  id         String        @id @default(uuid()) @db.Uuid
  title      String        @db.VarChar(200)
  difficulty DSADifficulty
  topic      String        @db.VarChar(120)
  platform   DSAPlatform
  url        String        @db.VarChar(2048)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  progress DSAProgress[]

  @@index([difficulty])
  @@index([topic])
  @@index([platform])
  @@map("dsa_problems")
}

model DSAProgress {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  problemId    String         @map("problem_id") @db.Uuid
  status       DSASolveStatus @default(UNSOLVED)
  attempts     Int            @default(0)
  lastSolvedAt DateTime?      @map("last_solved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem DSAProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // At most one progress row per user/problem pair.
  @@unique([userId, problemId])
  @@index([userId, status])
  @@map("dsa_progress")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(160)
  description  String?       @db.Text
  technologies String[]      @default([])
  status       ProjectStatus @default(PLANNED)
  githubUrl    String?       @map("github_url") @db.VarChar(2048)
  liveUrl      String?       @map("live_url") @db.VarChar(2048)
  startDate    DateTime?     @map("start_date")
  endDate      DateTime?     @map("end_date")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("projects")
}

model StudyTask {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  title            String       @db.VarChar(200)
  description      String?      @db.Text
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  dueDate          DateTime     @map("due_date")
  category         String       @db.VarChar(120)
  estimatedMinutes Int?         @map("estimated_minutes")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("study_tasks")
}

/// Resume metadata only. Binary files are never stored in PostgreSQL; `fileUrl`
/// points at future object storage and stays null until upload is implemented.
model Resume {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  fileName   String         @map("file_name") @db.VarChar(255)
  fileUrl    String?        @map("file_url") @db.VarChar(2048)
  targetRole String         @map("target_role") @db.VarChar(160)
  version    Int
  status     ResumeStatus   @default(CURRENT)
  fileType   ResumeFileType @map("file_type")
  fileSize   Int?           @map("file_size")
  uploadedAt DateTime       @default(now()) @map("uploaded_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("resumes")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(160)
  message   String           @db.VarChar(1000)
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}
